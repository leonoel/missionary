{:deps
 {org.reactivestreams/reactive-streams {:mvn/version "1.0.4"}
  org.replikativ/hasch {:mvn/version "0.3.97"}
  cloroutine/cloroutine {:mvn/version "13"}}

 :paths ["src" "target/classes"]

 :aliases
 {:tck
  {:extra-deps {org.reactivestreams/reactive-streams-tck {:mvn/version "1.0.4"}}}

  :dev {:extra-paths ["test"]}

  :codox
  {:extra-deps {codox/codox {:mvn/version "0.10.8"}}
   :exec-fn codox.main/generate-docs
   :exec-args {:source-paths ["src"]
               :codox {:writer codox.writer.html/write-docs}}}

  :deploy
  {:extra-deps {slipset/deps-deploy {:mvn/version "0.2.2"}}
   :exec-fn deps-deploy.deps-deploy/deploy
   :exec-args {:installer :remote
               :artifact "target/missionary-b.47.jar"}}

  :clj-test
  {:extra-deps  {com.cognitect/test-runner
                 {:git/url "https://github.com/cognitect-labs/test-runner.git"
                  :sha     "028a6d41ac9ac5d5c405dfc38e4da6b4cc1255d5"}}
   :extra-paths ["test"]
   :main-opts   ["-m" "cognitect.test-runner"]}

  :clj-test-watch {:extra-deps {lambdaisland/kaocha {:mvn/version "1.69.1069"}}
                   :extra-paths ["test"]
                   :exec-fn missionary.test-dev/run}
  :cljs-test
  {:extra-deps  {olical/cljs-test-runner {:mvn/version "3.8.0"}
                 org.clojure/clojurescript {:mvn/version "1.11.60"}}
   :extra-paths ["test" "cljs-test-runner-out/gen"]
   :main-opts   ["-m" "cljs-test-runner.main"]}

  :perf
  ;; sudo sysctl -w kernel.perf_event_paranoid=1 && sudo sysctl -w kernel.kptr_restrict=0
  {:extra-deps  {com.clojure-goes-fast/clj-async-profiler {:mvn/version "2.0.0-beta1"}}
   :extra-paths ["test"]
   :jvm-opts    ["-Djdk.attach.allowAttachSelf"
                 "-XX:+UnlockDiagnosticVMOptions"
                 "-XX:+DebugNonSafepoints"]}

  :lincheck
  {:extra-deps  {org.jetbrains.lincheck/lincheck {:mvn/version "3.4"}
                 org.junit.jupiter/junit-jupiter {:mvn/version "6.0.3"}
                 org.junit.platform/junit-platform-console {:mvn/version "6.0.3"}
                 ;; Override Lincheck's ASM 9.6 -> 9.9.1 for Java 25 support
                 org.ow2.asm/asm {:mvn/version "9.9.1"}
                 org.ow2.asm/asm-commons {:mvn/version "9.9.1"}
                 org.ow2.asm/asm-tree {:mvn/version "9.9.1"}
                 org.ow2.asm/asm-util {:mvn/version "9.9.1"}
                 org.ow2.asm/asm-analysis {:mvn/version "9.9.1"}}
   :extra-paths ["test" "lincheck-classes"]
   :jvm-opts    ["--add-opens" "java.base/java.lang=ALL-UNNAMED"
                 "--add-opens" "java.base/java.lang.invoke=ALL-UNNAMED"
                 "--add-opens" "java.base/jdk.internal.misc=ALL-UNNAMED"
                 "--add-opens" "java.base/sun.nio.ch=ALL-UNNAMED"
                 "-Djdk.attach.allowAttachSelf"
                 "-XX:+EnableDynamicAgentLoading"]}}}
